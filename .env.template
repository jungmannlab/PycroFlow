# .env.template — copy to `.env` in the PycroFlow repo root and fill in.
#
# `.env` is GITIGNORED and per-machine: it carries secrets (bearer tokens) and
# machine-local paths. NEVER commit a filled-in copy (`git add -f`/-A bypasses
# gitignore — that is how a live token once landed in history; rotate
# immediately if it happens again). This template IS tracked — add new
# variables here with a placeholder, never a real value.
#
# Loading: the PycroFlow frontends (`pycroflow`, `pycroflow-gui`) load this
# file at startup with override=False, so an already-exported shell variable
# (or a systemd EnvironmentFile) still wins. monet independently loads the
# same file at import. On machines without python-dotenv the file is ignored —
# export the variables in the shell instead.
#
# Path lists: separate multiple paths with the OS path separator — ";" on
# Windows (the lab's microscope PCs), ":" on Linux/macOS.
#
# WINDOWS GOTCHA — network paths: mapped drive letters (Z:) are PER-SESSION;
# a GUI launched from a shortcut, another account, or an elevated prompt may
# not see them, and consumers that "use the first path that exists" (monet)
# then silently fall back to defaults. Prefer UNC paths
# (//server/share/monet-data/configs.yaml or \\server\share\...) which
# resolve in every session.

# --- picasso-registry (WP-LIVE-INT: live-analysis records + monitoring clip
#     index). Unset URL = registry writes quietly disabled; the token is the
#     A9/C18 bearer credential for a networked/authenticated registry
#     (loopback dev servers run tokenless). ------------------------------------
PAINT_REGISTRY_URL=
PAINT_REGISTRY_TOKEN=
# On-disk outbox of the buffered client (replays when the registry is back).
PYCROFLOW_REGISTRY_BUFFER=registry_buffer.sqlite

# --- monet (illumination) — mirrors monet's own .env.template ----------------
MONET_CONFIG_PATHS=
MONET_PROTOCOL_PATHS=
PAINT_MONET_AUTH=
PAINT_MONET_TOKEN=

# --- PycroFlow ----------------------------------------------------------------
# Spill-sensor Arduino serial port (e.g. COM5).
PYCROFLOW_SPILL_PORT=
# Kill switch for live analysis in orchestrated runs (0/off/false/no).
# PYCROFLOW_LIVE_ANALYSIS=0
# Dev-only: regenerate protocol regression snapshots during the test run.
# PYCROFLOW_UPDATE_SNAPSHOTS=1
